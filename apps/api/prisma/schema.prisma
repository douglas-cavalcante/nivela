generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  teacher
  student

  @@map("role")
}

enum TokenChannel {
  web
  mobile

  @@map("token_channel")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(190)
  password  String   @db.VarChar(100)
  role      Role     @default(student)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  studentProfile   StudentProfile?
  accessTokens     AccessToken[]
  classrooms       Classroom[]
  enrollments      ClassroomStudent[]
  questions        Question[]
  attempts         QuestionAttempt[]
  coinTransactions CoinTransaction[]

  @@map("users")
}

model StudentProfile {
  userId        Int       @id @map("user_id")
  coinsBalance  Int       @default(0) @map("coins_balance")
  currentStreak Int       @default(0) @map("current_streak")
  bestStreak    Int       @default(0) @map("best_streak")
  lastStudyDate DateTime? @map("last_study_date") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model AccessToken {
  id         Int          @id @default(autoincrement())
  userId     Int          @map("user_id")
  tokenHash  String       @unique @map("token_hash") @db.Char(64)
  channel    TokenChannel
  lastUsedAt DateTime?    @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("access_tokens")
}

model Classroom {
  id         Int      @id @default(autoincrement())
  teacherId  Int      @map("teacher_id")
  name       String   @db.VarChar(120)
  schoolYear String?  @map("school_year") @db.VarChar(40)
  joinCode   String   @unique @map("join_code") @db.VarChar(8)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  teacher  User               @relation(fields: [teacherId], references: [id])
  students ClassroomStudent[]

  @@index([teacherId])
  @@map("classrooms")
}

model ClassroomStudent {
  classroomId Int      @map("classroom_id")
  studentId   Int      @map("student_id")
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classroomId, studentId])
  @@index([studentId])
  @@map("classroom_student")
}

// Unicidade por nome sem diferenciar maiúsculas/espaços: índices funcionais
// `lower(name)` criados à mão na migration subjects_categories (o Prisma não
// os representa no schema).
model Subject {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(60)
  color     String   @db.VarChar(20)
  icon      String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  categories Category[]
  questions  Question[]

  @@map("subjects")
}

model Category {
  id        Int      @id @default(autoincrement())
  subjectId Int      @map("subject_id")
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  questions Question[]

  // Alvo da FK composta questions_category_subject_fkey (categoria × disciplina).
  @@unique([id, subjectId], map: "categories_id_subject_id_key")
  @@index([subjectId])
  @@map("categories")
}

enum Difficulty {
  easy
  medium
  hard

  @@map("difficulty")
}

model Question {
  id          Int        @id @default(autoincrement())
  authorId    Int        @map("author_id")
  subjectId   Int        @map("subject_id")
  categoryId  Int        @map("category_id")
  statement   String
  imagePath   String?    @map("image_path") @db.VarChar(255)
  difficulty  Difficulty
  explanation String
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  author   User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  subject  Subject           @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  category Category          @relation(fields: [categoryId, subjectId], references: [id, subjectId], onDelete: Restrict, onUpdate: NoAction, map: "questions_category_subject_fkey")
  options  QuestionOption[]
  attempts QuestionAttempt[]

  @@index([subjectId, categoryId, active])
  @@index([authorId])
  @@map("questions")
}

model QuestionOption {
  id         Int     @id @default(autoincrement())
  questionId Int     @map("question_id")
  letter     String  @db.Char(1)
  text       String
  isCorrect  Boolean @map("is_correct")

  question Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempts QuestionAttempt[]

  @@unique([questionId, letter])
  @@map("question_options")
}

enum CoinReason {
  correct_answer
  plan_completed
  streak_bonus
  redemption
  refund

  @@map("coin_reason")
}

// Unicidade das tentativas por contexto: índices únicos parciais criados à mão
// na migration answers (question_attempts_practice_key para plan_chapter_id
// nulo e question_attempts_chapter_key para não nulo) e CHECK de
// attempt_number (1 ou 2). A FK de plan_chapter_id entra com os planos.
model QuestionAttempt {
  id               Int      @id @default(autoincrement())
  studentId        Int      @map("student_id")
  questionId       Int      @map("question_id")
  planChapterId    Int?     @map("plan_chapter_id")
  selectedOptionId Int      @map("selected_option_id")
  attemptNumber    Int      @map("attempt_number") @db.SmallInt
  isCorrect        Boolean  @map("is_correct")
  coinsAwarded     Int      @default(0) @map("coins_awarded")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  student        User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption QuestionOption @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict)

  @@index([studentId, questionId])
  @@map("question_attempts")
}

// "Uma vez" por origem: índices únicos parciais criados à mão na migration
// answers (coin_once_per_question, coin_once_per_plan, coin_once_per_streak_day)
// e CHECK amount <> 0.
model CoinTransaction {
  id         Int        @id @default(autoincrement())
  studentId  Int        @map("student_id")
  amount     Int
  reason     CoinReason
  sourceType String     @map("source_type") @db.VarChar(30)
  sourceId   Int        @map("source_id")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("coin_transactions")
}
