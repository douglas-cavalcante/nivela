PORT=8000
DATABASE_URL=postgresql://nivela:nivela@localhost:5433/nivela
TZ=America/Fortaleza
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@nivela.test
ADMIN_PASSWORD=nivela123

# Origens liberadas no CORS, separadas por vírgula (ex.: http://localhost:5173,http://192.168.0.10:5173).
# Sem esta variável, a API libera as origens de desenvolvimento (Vite em 5173 e Expo web em 8081/19006).
# CORS_ORIGINS=http://localhost:5173

# Pasta dos arquivos enviados (imagens de questões), servida em /uploads.
UPLOADS_DIR=uploads

# Limite de tentativas nas rotas públicas de autenticação (janela em segundos).
# Login: por ip + e-mail. Cadastro: por ip. Os valores abaixo são os padrões.
# O ip vem da conexão direta (sem `trust proxy`): atrás de um proxy reverso todos
# os clientes pareceriam ter o mesmo ip, então este projeto assume que não há proxy.
# THROTTLE_LOGIN_LIMIT=10
# THROTTLE_REGISTER_LIMIT=30
# THROTTLE_TTL_SECONDS=60
