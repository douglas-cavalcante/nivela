{
  "expo": {
    "name": "Nivela",
    "slug": "nivela",
    "scheme": "nivela",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "package": "br.nivela.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFDF6"
      }
    },
    "ios": { "bundleIdentifier": "br.nivela.app" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        { "image": "./assets/splash-icon.png", "imageWidth": 200, "backgroundColor": "#FFFDF6" }
      ],
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
