# URL da API. Emulador Android: 10.0.2.2 aponta para o localhost da máquina.
# Celular físico: use o IP da sua máquina na rede (ex.: http://192.168.0.10:8000/api/v1).
# Este é só o endereço padrão: no app, em Boas-vindas ou Entrar, "Servidor · Alterar" troca o endereço no aparelho.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
